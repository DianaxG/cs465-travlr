{{> header }}

<h1>{{title}}</h1>

<div class="trip-list">
  {{#each trips}}
    <div class="trip">
      <img src="{{image}}" alt="{{name}}" style="max-width: 300px;" />
      <h2>{{name}}</h2>
      <p><strong>Length:</strong> {{length}}</p>
      <p><strong>Start Date:</strong> {{start}}</p>
      <p><strong>Resort:</strong> {{resort}}</p>
      <p><strong>Price:</strong> {{perPerson}}</p>
      <p>{{description}}</p>
    </div>
  {{/each}}
</div>

{{> footer }}
